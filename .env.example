# Local dev: SQLite file relative to prisma/schema.prisma (-> prisma/dev.db)
# Docker: overridden in docker-compose.yml to file:/app/db/nuzlocke.db (named volume)
DATABASE_URL="file:./dev.db"

# --- Public instance (Vercel) ------------------------------------------------
# None of this is needed for the self-hosted container. The public build is
# made by `npm run build:public` (vercel.json's buildCommand), which switches
# the public mode on itself - do not set NEXT_PUBLIC_INSTANCE_MODE by hand.
#
# Set by the Vercel Marketplace's Turso integration; `vercel env pull .env.local`
# fetches them for `npm run migrate:turso`.
# TURSO_DATABASE_URL="libsql://your-database.turso.io"
# TURSO_AUTH_TOKEN=""
#
# prisma generate needs some DATABASE_URL to load its config even though it
# never connects; scripts/build-public.mjs supplies a placeholder if unset.
#
# Vercel sends this as `Authorization: Bearer ...` to the daily cleanup cron
# (/api/cron/cleanup). Without it the route answers 401 to everyone.
# CRON_SECRET=""
#
# Legal pages, shown in the footer. Each takes a link to a page that already
# exists, or the text itself (which is then served at /impressum or
# /datenschutz). A link wins if both are set; unset means no footer link.
# LEGAL_IMPRINT_URL=""
# LEGAL_IMPRINT_TEXT=""
# LEGAL_PRIVACY_URL=""
# LEGAL_PRIVACY_TEXT=""
