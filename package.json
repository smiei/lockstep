{
  "name": "lockstep",
  "version": "5.0.0",
  "private": true,
  "description": "Self-hosted Pokémon Nuzlocke and SoulLink tracker for 1-4 players.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/smiei/lockstep.git"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "predev": "npm run generate:icons",
    "dev": "next dev",
    "prebuild": "npm run generate:icons",
    "build": "next build",
    "build:public": "node scripts/build-public.mjs",
    "build:windows": "node scripts/build-windows.mjs",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "generate:icons": "node scripts/generate-icons.mjs",
    "generate:evolutions": "node scripts/generate-evolutions.mjs",
    "generate:names": "node scripts/generate-names.mjs",
    "generate:learnsets": "node scripts/generate-learnsets.mjs",
    "generate:if-species": "node scripts/generate-infinite-fusion-species.mjs",
    "generate:if-moves": "node scripts/generate-infinite-fusion-moves.mjs",
    "generate:trainer-sprites": "node scripts/generate-trainer-sprite-map.mjs",
    "download:sprites": "node scripts/download-sprites.mjs",
    "download:catchrates": "node scripts/download-catchrates.mjs",
    "download:badges": "node scripts/download-badges.mjs",
    "download:trainers": "node scripts/download-trainers.mjs",
    "validate:packs": "vitest run src/lib/__tests__/gamePacks.test.ts",
    "pack": "node scripts/pack-tool.mjs",
    "migrate:turso": "node scripts/migrate-turso.mjs"
  },
  "dependencies": {
    "@libsql/client": "^0.8.1",
    "@prisma/adapter-libsql": "^7.10.1",
    "@prisma/client": "^6.19.3",
    "dotenv": "^17.4.2",
    "fflate": "^0.8.3",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "prisma": "^6.19.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@hyrious/marshal": "^0.3.4",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
