node_modules
.next
.git
.env
.env.*
prisma/dev.db
prisma/dev.db-journal
src/generated
npm-debug.log*
.DS_Store

# Copyrighted game artwork stays out of the (public) image: Pokémon sprites
# and badge icons are auto-downloaded on first container start into a
# volume, trainer sprites are user-provided via a volume mount.
public/pokemon-sprites
public/ball-sprites
public/badges
public/trainers/*.png
public/trainers/**/*.png

# Regenerated by `npm run build`'s prebuild hook inside the builder stage, so
# a stale local copy must not enter the build context.
public/icons

# Local reference clone of another tracker (see .gitignore): not part of this app.
reference_domtronn_nuzlocke_app

# Private branding override - applied at runtime via a mount, never baked in.
branding-local

# Local-only working folders (never part of the image, and the videos and
# screenshots in them show Pokémon artwork). A CI checkout has none of them;
# excluding them keeps a local build context small.
brag-output*
release-assets
raw_trainer_sprites
graphify-out
fboschinfinite-fusion-nuzlocke
.ui-audit
PUBLIC_RELEASE.md
